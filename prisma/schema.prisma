generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enum removed for SQLite compatibility
// enum UserRole { ADMIN, CUSTOMER }
// enum OrderStatus { ... }
// enum PaymentMethod { ... }

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         String   @default("CUSTOMER")
  status       String   @default("ACTIVE") // ACTIVE, BANNED
  avatar    String?
  phone     String?
  bio       String?
  gender    String?   // MALE, FEMALE, OTHER
  birthDate String?   // ISO date string for SQLite
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Product {
  id            String      @id @default(cuid())
  name          String
  description   String
  price         Float
  image         String
  category      String
  stock         Int
  rating        Float?      @default(0)
  isRecommended Boolean     @default(false)
  sizes         String?     // Comma separated sizes
  finishing     String?     // Comma separated: Laminasi,Doff,Glossy
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  totalAmount     Float
  status          String        @default("PENDING") // Was OrderStatus
  paymentMethod   String        // Was PaymentMethod
  paymentProof    String?
  shippingAddress String
  shippingMethod  String
  shippingCost    Float
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  fileUrl   String?
  options   String?     // Stored as JSON string
}
